# ============================================================
# .env.example — 环境变量模板文件
# 版本：V8.1-Fixed
# 说明：复制此文件为 .env 并填写实际值
# 警告：.env 文件包含敏感信息，切勿提交到版本控制
# ============================================================
#
# 【审查与修复记录】
# ──────────────────────────────────────────────────────────────
# 问题 #1：BINANCE_API_KEY/SECRET 缺少格式说明
#   └── 修复：增加格式要求和获取方式说明
#
# 问题 #2：SNAPSHOT_ENCRYPTION_KEY 生成命令不准确
#   └── 修复：明确 AES-256 需要 32 字节，Base64 编码后为 44 字符
#   └── 添加 Python 生成方式作为备选
#
# 问题 #3：MAX_ORDERS_PER_SECOND 默认值 10 可能触发限频
#   └── 修复：区分现货和合约限频，合约推荐 5/秒
#
# 问题 #4：缺少 WebSocket 相关配置
#   └── 修复：新增 WS_PING_INTERVAL、WS_RECONNECT_DELAY 等
#
# 问题 #5：缺少 SSL/TLS 证书配置
#   └── 修复：新增 SSL_CA_CERT_PATH、SSL_VERIFY
#
# 问题 #6：缺少代理配置
#   └── 修复：新增 HTTP_PROXY、HTTPS_PROXY
#
# 问题 #7：缺少资金费率相关配置
#   └── 修复：新增 FUNDING_RATE_CHECK_INTERVAL、FUNDING_RATE_THRESHOLD
#
# 问题 #8：缺少币种启用配置
#   └── 修复：新增 ENABLED_SYMBOLS
#
# 问题 #9：缺少模拟/实盘显式切换开关
#   └── 修复：新增 TRADING_MODE
#
# 问题 #10：注释中的"必填"标记不准确
#   └── 修复：明确标注【生产环境必填】和【可选】
#
# 问题 #11：文件末尾缺少换行符
#   └── 修复：添加末尾换行符
#
# 问题 #12：JWT_SECRET_KEY 长度说明不充分
#   └── 修复：明确 32 字符以上，建议 64 字符
# ──────────────────────────────────────────────────────────────
# 兼容性：bash/sh/dotenv 格式，兼容 Python-dotenv、Node.js dotenv
# ============================================================


# ============================================================
# 运行环境
# ============================================================

# 环境模式：development | production | test
# 【生产环境必填】
ENV_MODE=production

# 系统时区（影响日志时间戳）
TZ=Asia/Shanghai

# 调试模式：true | false（生产环境必须为 false）
DEBUG=false

# 日志级别：DEBUG | INFO | WARN | ERROR
# 生产环境建议 INFO 或 WARN
LOG_LEVEL=INFO


# ============================================================
# 交易模式（重要！）
# ============================================================

# 交易模式：LIVE（实盘）| PAPER（模拟盘）| BACKTEST（回测）
# 【生产环境必填】实盘交易前务必确认设置为 LIVE
TRADING_MODE=PAPER

# 模拟盘初始资金（USDT），仅在 PAPER 模式下生效
PAPER_INITIAL_CAPITAL=100000


# ============================================================
# 币安交易所 API 配置
# ============================================================

# ---- 生产环境（实盘）-【生产环境必填】 ----
# 币安 API Key（从币安 API 管理后台获取）
# 格式：字母数字混合，通常 64 字符
# 获取地址：https://www.binance.com/zh-CN/support/faq/how-to-create-api-keys-on-binance-360002502072
BINANCE_API_KEY=your_binance_api_key_here

# 币安 API Secret（从币安 API 管理后台获取）
# 格式：字母数字混合，通常 64 字符
# 警告：切勿泄露此密钥
BINANCE_API_SECRET=your_binance_api_secret_here

# ---- 测试网环境（测试用，可选） ----
# 测试网 API Key（用于功能验证，非实盘）
# 获取地址：https://testnet.binancefuture.com/
BINANCE_TESTNET_API_KEY=your_testnet_api_key_here
BINANCE_TESTNET_API_SECRET=your_testnet_api_secret_here

# ---- 沙盒环境（模拟用，可选） ----
# 沙盒 API Key（用于策略模拟，非实盘）
# 获取地址：https://sandbox.binance.com/
BINANCE_SANDBOX_API_KEY=your_sandbox_api_key_here
BINANCE_SANDBOX_API_SECRET=your_sandbox_api_secret_here


# ============================================================
# API 端点配置
# ============================================================

# 币安 API 基础 URL（一般无需修改）
BINANCE_API_BASE_URL=https://fapi.binance.com

# 币安 WebSocket 基础 URL
BINANCE_WS_BASE_URL=wss://fstream.binance.com

# 测试网 API 基础 URL
BINANCE_TESTNET_API_BASE_URL=https://testnet.binancefuture.com
BINANCE_TESTNET_WS_BASE_URL=wss://stream.binancefuture.com


# ============================================================
# 服务端口配置
# ============================================================

# 后端 REST API 端口
BACKEND_PORT=8080

# 后端 WebSocket 端口（用于推送实时数据）
BACKEND_WS_PORT=8081

# 前端 Web 服务端口
FRONTEND_PORT=3000

# Prometheus 监控指标端口
METRICS_PORT=9090

# 健康检查端点路径
HEALTH_CHECK_PATH=/api/health


# ============================================================
# Redis 缓存配置
# ============================================================

# Redis 连接地址
REDIS_HOST=localhost

# Redis 端口
REDIS_PORT=6379

# Redis 密码（若无则留空）
REDIS_PASSWORD=

# Redis 数据库编号（0-15）
REDIS_DB=0

# Redis 连接池大小
REDIS_POOL_SIZE=10

# Redis 连接超时（秒）
REDIS_TIMEOUT=5

# Redis 键前缀（用于多实例隔离）
REDIS_KEY_PREFIX=ema:


# ============================================================
# 数据库配置（可选，用于持久化交易记录）
# ============================================================

# 数据库类型：sqlite | postgres | mysql
DB_TYPE=sqlite

# SQLite 数据库文件路径（DB_TYPE=sqlite 时使用）
SQLITE_DB_PATH=./data/trading.db

# PostgreSQL 配置（DB_TYPE=postgres 时使用）
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# MySQL 配置（DB_TYPE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DB=trading
MYSQL_USER=root
MYSQL_PASSWORD=mysql_password


# ============================================================
# 安全与加密（【生产环境必填】）
# ============================================================

# 快照加密密钥（AES-256-GCM，需要 32 字节密钥）
# 生成方式：
#   方式1（推荐）：openssl rand -base64 32
#   方式2（Python）：python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# 注意：生成的 Base64 字符串长度为 44 字符（含填充）
SNAPSHOT_ENCRYPTION_KEY=your_base64_44char_key_here

# JWT 密钥（用于 API 认证）
# 要求：至少 32 字符，建议 64 字符，可使用大小写字母+数字+特殊字符
# 生成方式：openssl rand -base64 48
JWT_SECRET_KEY=your_jwt_secret_key_at_least_32_chars_long

# API 请求签名密钥（用于内部 API 签名验证）
# 要求：至少 32 字符
API_SIGN_KEY=your_api_sign_key_at_least_32_chars


# ============================================================
# WebSocket 配置
# ============================================================

# WebSocket 心跳间隔（秒）
WS_PING_INTERVAL=30

# WebSocket 断线重连延迟（秒）
WS_RECONNECT_DELAY=1

# WebSocket 最大重连延迟（秒）
WS_MAX_RECONNECT_DELAY=60

# WebSocket 消息超时（秒）
WS_MESSAGE_TIMEOUT=10

# WebSocket 数据流订阅最大重试次数
WS_MAX_RETRIES=5


# ============================================================
# SSL/TLS 配置
# ============================================================

# SSL 验证：true | false（生产环境必须为 true）
SSL_VERIFY=true

# 自定义 CA 证书路径（使用自签名证书时填写）
SSL_CA_CERT_PATH=

# 客户端证书路径（双向认证时使用）
SSL_CLIENT_CERT_PATH=

# 客户端私钥路径（双向认证时使用）
SSL_CLIENT_KEY_PATH=


# ============================================================
# 代理配置（可选）
# ============================================================

# HTTP 代理地址（格式：http://user:pass@host:port）
HTTP_PROXY=

# HTTPS 代理地址
HTTPS_PROXY=

# 不使用代理的地址列表（逗号分隔）
NO_PROXY=localhost,127.0.0.1


# ============================================================
# 数据存储路径
# ============================================================

# 历史数据存储路径
DATA_PATH=./data

# 快照存储路径
SNAPSHOT_PATH=./data/snapshots

# 日志存储路径
LOG_PATH=./logs

# 回测数据路径
BACKTEST_DATA_PATH=./data/backtest

# 临时文件路径
TMP_PATH=./tmp


# ============================================================
# 限频与控制
# ============================================================

# 【重要】币安合约订单限频：10秒内最多10单，1分钟内最多1200单
# 建议：每秒不超过 5 单（保守值）
MAX_ORDERS_PER_SECOND=5

# 币安 REST API 权重限频：IP 级别 2400/分钟
# 建议：预留 20% 缓冲，设为 1900
MAX_WEIGHT_PER_MINUTE=1900

# 最大持仓仓位（基础单位倍数）
MAX_POSITION=3.0

# 日最大亏损（USDT），达到后自动停止交易
MAX_DAILY_LOSS=1000


# ============================================================
# 资金费率配置
# ============================================================

# 资金费率检查间隔（秒）
FUNDING_RATE_CHECK_INTERVAL=300

# 资金费率极端阈值（超过此值触发预警）
# 正阈值：多头拥挤预警
FUNDING_RATE_THRESHOLD_POSITIVE=0.001

# 负阈值：空头拥挤预警
FUNDING_RATE_THRESHOLD_NEGATIVE=-0.001

# 资金费率结算前检查提前量（秒）
FUNDING_SETTLEMENT_AHEAD=300


# ============================================================
# 币种启用配置
# ============================================================

# 启用交易的币种（逗号分隔）
ENABLED_SYMBOLS=BTCUSDT,ETHUSDT

# 各币种独立杠杆倍数
BTCUSDT_LEVERAGE=3
ETHUSDT_LEVERAGE=3

# 各币种最大仓位（覆盖全局 MAX_POSITION）
BTCUSDT_MAX_POSITION=3.0
ETHUSDT_MAX_POSITION=2.5


# ============================================================
# 通知配置（【生产环境建议必填】）
# ============================================================

# Telegram Bot Token（用于实时告警）
# 获取方式：@BotFather 创建 Bot
TELEGRAM_BOT_TOKEN=

# Telegram Chat ID（接收通知的群组/用户）
# 获取方式：@userinfobot
TELEGRAM_CHAT_ID=

# 邮件通知配置（SMTP）
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFICATION_EMAIL=

# 通知级别：ERROR | WARN | INFO
NOTIFICATION_LEVEL=ERROR


# ============================================================
# 系统维护
# ============================================================

# 日志保留天数
LOG_RETENTION_DAYS=30

# 快照保留数量
SNAPSHOT_RETENTION_COUNT=100

# 自动清理间隔（小时）
AUTO_CLEANUP_INTERVAL_HOURS=24

# 维护任务执行时间（UTC+8，24小时制）
MAINTENANCE_HOUR=3

# 是否启用自动更新检查
AUTO_UPDATE_CHECK=true


# ============================================================
# 高级配置（可选）
# ============================================================

# 启用性能分析（true | false）
ENABLE_PROFILING=false

# 启用内存追踪（true | false）
ENABLE_MEMORY_TRACKING=false

# 启用请求追踪（true | false）
ENABLE_REQUEST_TRACING=false

# 启用详细 GC 日志（仅开发环境）
ENABLE_GC_LOGGING=false

# 自定义配置文件路径（覆盖默认配置）
CUSTOM_CONFIG_PATH=


# ============================================================
# 配置完成
# ============================================================
#
# 使用说明：
#   1. 复制此文件为 .env
#   2. 填写所有标记为【生产环境必填】的变量
#   3. 根据实际环境调整可选配置
#   4. 确保 .env 文件已添加到 .gitignore
#   5. 重启服务使配置生效
#
# 快速启动检查清单：
#   [ ] TRADING_MODE 设置为 PAPER（首次运行）
#   [ ] BINANCE_API_KEY 和 SECRET 已填写
#   [ ] SNAPSHOT_ENCRYPTION_KEY 已生成
#   [ ] JWT_SECRET_KEY 已设置
#   [ ] REDIS_HOST 可访问
#   [ ] TRADING_MODE 确认为 LIVE（实盘前）
#
# 安全提醒：
#   - 请勿将 .env 文件提交到版本控制
#   - API Key 和 Secret 应定期轮换（建议每季度）
#   - 生产环境建议使用密钥管理服务（如 HashiCorp Vault）
#   - 实盘交易前务必在测试网充分验证
# ============================================================
